<section class="cc-app-content cc-dossier-content">
  <header class="cc-section-header cc-dossier-header">
    <div>
      <div class="cc-eyebrow">Player Reference</div>
      <h2>Dossier</h2>
      <p class="cc-subtitle">Key NPCs the party has been given access to reference.</p>
    </div>
    {{#if isGM}}
      <button type="button" class="cc-secondary-button" data-action="manageDossier">
        <i class="fa-solid fa-gear"></i> Manage Dossier
      </button>
    {{/if}}
  </header>

  {{#if dossiers.length}}
    <label class="cc-search-box cc-dossier-search-box">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="search" data-role="dossier-search" placeholder="Search NPCs...">
    </label>

    <div class="cc-dossier-grid">
      {{#each dossiers}}
        <article class="cc-dossier-card" data-dossier-search="{{searchText}}">
          <div class="cc-dossier-card-portrait">
            <img src="{{path}}" alt="{{name}}" loading="lazy">
          </div>
          <div class="cc-dossier-card-body">
            <h3>{{name}}</h3>
            {{#if description}}<p>{{description}}</p>{{else}}<p class="cc-dossier-no-description">No description has been recorded.</p>{{/if}}
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <div class="cc-empty-state cc-dossier-empty-state">
      <i class="fa-solid fa-address-book"></i>
      <p>No key NPCs have been added to the dossier yet.</p>
      {{#if isGM}}<small>Use Manage Dossier to add NPC portraits, names, and descriptions.</small>{{/if}}
    </div>
  {{/if}}
</section>
